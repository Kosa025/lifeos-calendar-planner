# Copy this file to .env and fill in your own values.
# NEVER commit .env to git — it contains real secrets.

# Notion integration token (from https://www.notion.so/my-integrations)
NOTION_TOKEN=ntn_your_notion_integration_token_here

# ID of your Notion Daily Tasks database
# Found in the database URL: notion.so/workspace/<DATABASE_ID>?v=...
NOTION_DATABASE_ID=your_notion_database_id_here

# Path to your Google OAuth2 credentials JSON file
GOOGLE_CREDENTIALS_PATH=./credentials.json
